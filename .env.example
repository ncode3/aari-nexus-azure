TELEGRAM_BOT_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# PEP client URL examples:
# local single-process: http://localhost:8081
# docker compose: http://pep:8081
# azure container apps: http://<internal-pep-service>:8081
PEP_BASE_URL=http://localhost:8081
PEP_HEALTH_TIMEOUT_SECONDS=1
MODEL_TIMEOUT_SECONDS=20
NEXUS_MEMORY_PATH=data/nexus_memory.sqlite3
NEXUS_DEBUG_JSON=false

AZURE_REGION=eastus
APP_VERSION=0.3.0
APP_ENV=dev
BOT_POLL_INTERVAL_SECONDS=2
BOT_ALLOWED_CHAT_IDS=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=artifacts
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_KEY_VAULT_URI=
AZURE_CLIENT_ID=

# Cohort Desk. Links work without enabling the read-only Graph connection.
COHORT_GRAPH_ENABLED=false
# Optional Graph composite site ID; otherwise resolve the configured site URL.
COHORT_SITE_ID=
COHORT_SITE_URL=https://aari.sharepoint.com/sites/AARICohortDesk
COHORT_LIST_ID=c2b94b21-d99a-4608-8939-5fed06a86cde
COHORT_MAX_PAGES=100
# COHORT_APP_URL, COHORT_QUEUE_URL and COHORT_SUMMARY_URL may override built-in links.
# Live reporting uses AZURE_CLIENT_ID and requires an explicit BOT_ALLOWED_CHAT_IDS.
