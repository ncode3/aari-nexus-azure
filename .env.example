# Local PostgreSQL (development values only; replace before shared deployment)
POSTGRES_DB=aari
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=aari_admin
POSTGRES_ADMIN_PASSWORD=local-admin-change-me
POSTGRES_APP_USER=aari_app
POSTGRES_APP_PASSWORD=local-app-change-me
POSTGRES_READONLY_USER=aari_readonly
POSTGRES_READONLY_PASSWORD=local-readonly-change-me
DATABASE_URL=postgresql+psycopg://aari_app:local-app-change-me@localhost:5432/aari
DATABASE_ADMIN_URL=postgresql+psycopg://aari_admin:local-admin-change-me@localhost:5432/aari
READONLY_DATABASE_URL=postgresql+psycopg://aari_readonly:local-readonly-change-me@localhost:5432/aari

# Local MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=aari_minio_admin
MINIO_ROOT_PASSWORD=local-minio-change-me
MINIO_APP_USER=aari_app
MINIO_APP_PASSWORD=local-minio-app-change-me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aari_app
MINIO_SECRET_KEY=local-minio-app-change-me
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=aari-documents
MINIO_REJECTED_BUCKET=aari-rejected

# API
ENVIRONMENT=development
API_PORT=8000
MAX_UPLOAD_BYTES=52428800
EMBEDDING_PROVIDER=disabled
EMBEDDING_DIMENSIONS=1536

# Optional Redis profile; unused by default
REDIS_PORT=6379

# Optional legacy Azure workflow adapter. Never required by the core platform.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=artifacts
AZURE_SUBMISSION_API_URL=http://localhost:8000
AZURE_SUBMISSION_API_TOKEN=

# Optional legacy Telegram/Azure OpenAI service; disabled by default
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
PEP_BASE_URL=http://localhost:8081
