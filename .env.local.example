# Copy to .env.local. Keep credentials and student data out of Git.
# Default: authenticated loopback operator, with NO Telegram poller.
NEXUS_TELEGRAM_ENABLED=false
NEXUS_LOCAL_PORT=8765
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(36))"
NEXUS_LOCAL_API_TOKEN=
TELEGRAM_BOT_TOKEN=
BOT_ALLOWED_CHAT_IDS=
# Exact installed name from `ollama list`; no model is downloaded automatically.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_SECONDS=120
# python -m app.local forces Ollama and disables Azure services/Graph.
# Default persistent paths: data/nexus_memory.sqlite3 and data/artifacts.
# Override both paths together for durable state outside a checkout.
# NEXUS_MEMORY_PATH=C:/Users/YOU/AppData/Local/AARI/Nexus/state/nexus_memory.sqlite3
# NEXUS_LOCAL_ARTIFACT_PATH=C:/Users/YOU/AppData/Local/AARI/Nexus/state/artifacts
# Only for a separate test bot after its identity is independently verified:
# NEXUS_TELEGRAM_ENABLED=true
# NEXUS_TEST_BOT_CONFIRMED=true
