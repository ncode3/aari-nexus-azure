# Copy to .env.local. Keep credentials and student data out of Git.
TELEGRAM_BOT_TOKEN=
BOT_ALLOWED_CHAT_IDS=
# Exact installed name from `ollama list`; no model is downloaded automatically.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_SECONDS=120
# python -m app.local forces Ollama and disables Azure services/Graph.
# Default persistent paths: data/nexus_memory.sqlite3 and data/artifacts.
