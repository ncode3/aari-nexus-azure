// Read performance is technical latency, NOT staff time saved or business uptime.
// Events
// | summarize attempts = count(), unavailable_reads = countif(status == "unavailable"),
//             p50_read_seconds = percentile(read_seconds, 50),
//             p95_read_seconds = percentile(read_seconds, 95) by source_key
